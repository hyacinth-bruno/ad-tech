PORT=4001
MONGODB_URI=mongodb://localhost:27017/retail_media
RABBITMQ_URL=amqp://localhost:5672

# Optional - leave unset and the app logs a warning and skips indexing.
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_CAMPAIGNS_INDEX=campaigns
ALGOLIA_PRODUCTS_INDEX=products

# Enable only after the corresponding models are activated in Algolia.
# NeuralSearch follows the product index's native mode setting.
ALGOLIA_PERSONALIZATION_ENABLED=false
ALGOLIA_RERANKING_ENABLED=false
ALGOLIA_QUERY_CATEGORIZATION_ENABLED=false
# Optional separate search-scoped key for Insights (otherwise uses the server key).
ALGOLIA_INSIGHTS_API_KEY=


NODE_ENV=development
LOG_LEVEL=info
